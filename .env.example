AUDITOR_ALLOWED_API_KEY_ENVS=
AUDITOR_API_KEY_BASE_URL_BINDINGS={}
AUDITOR_ACCESS_TOKEN=
AUDITOR_MANAGEMENT_TOKEN=

# 真实端点上线时只填环境变量，不要把密钥提交到 Git。
